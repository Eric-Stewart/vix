<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VIX Metrics Dashboard</title>
    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #f4f4f9;
        }
        h1 {
            color: #333;
        }
        .metrics {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            max-width: 600px;
            margin-bottom: 20px;
        }
        .metric {
            margin: 10px 0;
            font-size: 18px;
        }
        .recommendations {
            background: #e8f4f8;
            padding: 20px;
            border-radius: 8px;
            max-width: 600px;
            margin-bottom: 20px;
        }
        .recommendation {
            margin: 10px 0;
            font-size: 16px;
            line-height: 1.5;
        }
        .plot {
            max-width: 800px;
            margin: 20px 0;
        }
        .error {
            color: red;
        }
        #vixPlot {
            width: 100%;
            height: 500px;
        }
    </style>
</head>
<body>
    <h1>VIX Metrics Dashboard</h1>
    <div class="metrics">
        <% if (metrics.error) { %>
            <p class="error"><%= metrics.error %></p>
        <% } else { %>
            <div class="metric"><strong>Current VIX Price:</strong> <%= metrics.vixPrice %></div>
            <div class="metric"><strong>9-Day Moving Average:</strong> <%= metrics.vix9dMa %></div>
            <div class="metric"><strong>50-Day Moving Average:</strong> <%= metrics.vix50dMa %></div>
            <div class="metric"><strong>200-Day Moving Average:</strong> <%= metrics.vix200dMa %></div>
            <div class="metric"><strong>VIX/S&P 500 Correlation (30 days):</strong> <%= metrics.vixSp500Corr %></div>
        <% } %>
    </div>
    <div class="recommendations">
        <h2>Recommended Actions</h2>
        <% if (metrics.recommendations && metrics.recommendations.length > 0) { %>
            <% metrics.recommendations.forEach(rec => { %>
                <div class="recommendation"><%= rec %></div>
            <% }); %>
        <% } else { %>
            <div class="recommendation">No recommendations available.</div>
        <% } %>
    </div>
    <div class="plot">
        <h2>VIX Price and Moving Averages</h2>
        <% if (metrics.plotData) { %>
            <div id="vixPlot"></div>
            <script>
                const plotData = <%- JSON.stringify(metrics.plotData) %>;
                const traces = [
                    {
                        x: plotData.dates,
                        y: plotData.closes,
                        name: 'VIX Price',
                        type: 'scatter',
                        mode: 'lines',
                        line: { color: 'blue', width: 2 }
                    },
                    {
                        x: plotData.dates,
                        y: plotData.ma9,
                        name: '9-Day MA',
                        type: 'scatter',
                        mode: 'lines',
                        line: { color: 'orange', width: 1.5, dash: 'dash' }
                    },
                    {
                        x: plotData.dates,
                        y: plotData.ma50,
                        name: '50-Day MA',
                        type: 'scatter',
                        mode: 'lines',
                        line: { color: 'green', width: 1.5, dash: 'dot' }
                    },
                    {
                        x: plotData.dates,
                        y: plotData.ma200,
                        name: '200-Day MA',
                        type: 'scatter',
                        mode: 'lines',
                        line: { color: 'red', width: 1.5 }
                    },
                    {
                        x: [plotData.currentDate],
                        y: [plotData.currentPrice],
                        name: 'Current Price',
                        type: 'scatter',
                        mode: 'markers',
                        marker: { color: 'black', size: 10 }
                    }
                ];
                const layout = {
                    title: 'VIX Price and Moving Averages',
                    xaxis: { title: 'Date' },
                    yaxis: { title: 'VIX Value' },
                    showlegend: true,
                    height: 500
                };
                Plotly.newPlot('vixPlot', traces, layout);
            </script>
        <% } else { %>
            <p class="error">Unable to generate plot: No data available.</p>
        <% } %>
    </div>
</body>
</html>